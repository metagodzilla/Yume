{
  "expo": {
    "name": "Yume",
    "slug": "yume",
    "version": "1.5.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yume",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.yume.studio",
      "buildNumber": "22"
    },
    "android": {
      "package": "app.yume.studio",
      "versionCode": 22,
      "permissions": ["INTERNET", "CAMERA", "POST_NOTIFICATIONS", "REQUEST_INSTALL_PACKAGES", "FOREGROUND_SERVICE", "FOREGROUND_SERVICE_DATA_SYNC", "RECEIVE_BOOT_COMPLETED"],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#100814",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#100814"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Yume scans a setup QR code for the server address. The code does not contain your API key."
        }
      ],
      "expo-sharing",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#ff2d2d"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Yume saves the anime images you create into your photo library.",
          "savePhotosPermission": "Yume saves the anime images you create into your photo library.",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
